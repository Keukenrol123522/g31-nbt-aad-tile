--- /dev/null
+++ b/milestone-7/src/compat_gcc44.cpp
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
+// Required Notice: Copyright (c) 2026 nanaisu - NBT-AAD (https://github.com/Sq00ky/Supra-iDrive6-Android-Auto)
+//
+// Compatibility for linking against the head unit's own libstdc++.so.6 (QNX 6.5 SDP, GCC 4.4.2, libstdc++ 6.0.13)
+// while compiling with the GCC 4.9.4 toolchain. Two runtime helpers that GCC 4.9 headers/codegen call did not exist
+// yet in 6.0.13; without these definitions they stay undefined and the QNX loader only reports "unknown symbol" and
+// crashes if they are ever reached. Both are only used on error paths (vector::at out of range, new[] length overflow).
+// Why dynamic at all: the iDrive app starts the daemon with LD_PRELOAD=libEGL_X.gpp.so:... which loads the HU's GNU
+// libstdc++.so.6 into the process; a second, static libstdc++ in the executable crashed at the first DSI call (SIGSEGV).
+#include <cstdarg>
+#include <cstdio>
+#include <new>
+#include <stdexcept>
+
+namespace std {
+void __throw_out_of_range_fmt(const char* fmt, ...) {
+    char buf[256];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    throw std::out_of_range(buf);
+}
+} // namespace std
+
+extern "C" void __cxa_throw_bad_array_new_length() {
+    throw std::bad_alloc();   // std::bad_array_new_length has no typeinfo in 6.0.13
+}
