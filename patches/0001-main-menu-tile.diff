diff --git a/milestone-7/src/car/menu_tile.cpp b/milestone-7/src/car/menu_tile.cpp
new file mode 100644
index 0000000..0937a8f
--- /dev/null
+++ b/milestone-7/src/car/menu_tile.cpp
@@ -0,0 +1,195 @@
+// SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
+// Required Notice: Copyright (c) 2026 nanaisu - NBT-AAD (https://github.com/Sq00ky/Supra-iDrive6-Android-Auto)
+#include "car/menu_tile.hpp"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <vector>
+#include "most/ids.hpp"
+#include "most/msg.hpp"
+
+// RE notes (HmiMain3D May 2020 build, from issue #55): the CarLife main-menu tile is shown by the CarLife proxy's
+// AppState attribute (FktID 0xCF1, u8, 0 = available). The HMI subscribes to the properties of FBlock 0x24 inst 0x71 as
+// soon as a device with that key appears on MOST (Set Notification: fkt 0x001, data 01 <ctrl BE> <fkt BE>); the device
+// answers with a Status (opType 0xC) for each supported property and with the standard error (opType 0xF, fkt 0x001,
+// data 20 10 <fkt BE>) for the rest. Selecting the tile makes the HMI send Set 0xCE8 (1 byte: 0 tile, 1 Media entry).
+
+namespace nbt {
+namespace car {
+
+namespace {
+
+const uint16_t kTileKey = 0x2471;       // FBlock 0x24, instance 0x71
+const uint16_t kFktAppState = 0x0CF1;
+const uint16_t kFktFocusReq = 0x0CE8;
+const uint16_t kFktNotification = 0x001;
+
+} // namespace
+
+MenuTile::MenuTile()
+    : on_(false), always_(false), cb_(NULL), user_(NULL), want_(0), stop_(false), done_(false), registered_(false),
+      sent_(-1), dev_(0), ctrl_(0) {
+    pthread_mutex_init(&lock_, NULL);
+}
+
+bool MenuTile::attach(most::Client& client, TilePressCb cb, void* user) {
+    const char* e = getenv("NBT_TILE");
+    if (!(e && e[0] == '1')) {
+        printf("[Tile] main-menu tile off (NBT_TILE=1 turns it on)\n");
+        return false;
+    }
+    const char* a = getenv("NBT_TILE_ALWAYS");
+    always_ = a && a[0] == '1';
+    cb_ = cb;
+    user_ = user;
+    if (always_) want_ = 1;
+    most::DeviceHook h;
+    h.onRegistered = &MenuTile::registeredTramp;
+    h.onMessage = &MenuTile::messageTramp;
+    h.onTick = &MenuTile::tickTramp;
+    h.user = this;
+    if (!client.setDeviceHook(h) || !client.addLinkListener(&MenuTile::linkTramp, this)) {
+        printf("[Tile] no room on the MOST client: main-menu tile disabled\n");
+        return false;
+    }
+    on_ = true;
+    printf("[Tile] main-menu tile on: MOST device 0x%04X, tile %s\n", kTileKey,
+           always_ ? "always visible (NBT_TILE_ALWAYS=1)" : "follows the phone session");
+    return true;
+}
+
+void MenuTile::setVisible(bool visible) {
+    if (!on_) return;
+    pthread_mutex_lock(&lock_);
+    want_ = (always_ || visible) ? 1 : 0;
+    pthread_mutex_unlock(&lock_);
+}
+
+void MenuTile::shutdown() {
+    if (!on_) return;
+    pthread_mutex_lock(&lock_);
+    bool reg = registered_;
+    stop_ = true;
+    pthread_mutex_unlock(&lock_);
+    if (!reg) return;
+    for (int w = 0; w < 30; ++w) {
+        pthread_mutex_lock(&lock_);
+        bool d = done_;
+        pthread_mutex_unlock(&lock_);
+        if (d) break;
+        usleep(50000);     // the DSI thread unregisters on its next callback
+    }
+    usleep(300000);        // let the requests leave
+}
+
+void MenuTile::registeredTramp(DsiClient* c, uint32_t client, uint16_t dev, void* self) {
+    static_cast<MenuTile*>(self)->onRegistered(c, client, dev);
+}
+bool MenuTile::messageTramp(DsiClient* c, const most::View& m, uint32_t client, void* self) {
+    return static_cast<MenuTile*>(self)->onMessage(c, m, client);
+}
+void MenuTile::tickTramp(DsiClient* c, uint32_t client, void* self) { static_cast<MenuTile*>(self)->onTick(c, client); }
+void MenuTile::linkTramp(most::LinkState s, void* self) { static_cast<MenuTile*>(self)->onLink(s); }
+
+void MenuTile::onLink(most::LinkState s) {
+    // Only a lost connection ends the registration: after a re-attach the client registers again and onRegistered runs.
+    if (s != most::kDetached) return;
+    pthread_mutex_lock(&lock_);
+    registered_ = false;
+    pthread_mutex_unlock(&lock_);
+}
+
+void MenuTile::onRegistered(DsiClient* c, uint32_t client, uint16_t dev) {
+    dev_ = dev;
+    ctrl_ = 0;
+    sent_ = -1;
+    pthread_mutex_lock(&lock_);
+    registered_ = true;
+    pthread_mutex_unlock(&lock_);
+    std::vector<uint16_t> keys(1, kTileKey);
+    c->sendRequest(most::kReqRegisterDevices, most::buildRegisterDevCtrls(client, keys));   // we are FBlock 0x24 inst 0x71
+    printf("[Tile] registered MOST device 0x%04X (client %u, device id 0x%04X)\n", kTileKey, client, (unsigned)dev);
+}
+
+void MenuTile::send(DsiClient* c, uint32_t client, uint16_t fkt, uint8_t op, const uint8_t* d, size_t n) {
+    most::Msg m;
+    m.txType = 0; m.varTag = 1; m.varVal = 0;                  // device -> controller
+    m.dst = ctrl_; m.src = dev_;
+    m.fblock = (uint8_t)(kTileKey >> 8); m.inst = (uint8_t)(kTileKey & 0xff);
+    m.fkt = fkt; m.opType = op; m.hdrTag = (uint32_t)(dev_ & 0xff);
+    m.data.assign(d, d + n);
+    std::vector<uint8_t> mm = most::buildMessage(m);
+    std::vector<uint8_t> p;
+    most::putLe32(p, client);
+    p.insert(p.end(), mm.begin(), mm.end());
+    c->sendRequest(most::kReqProcessMessage, p);               // DSYSMOSTServer ProcessMessage
+}
+
+void MenuTile::publish(DsiClient* c, uint32_t client) {
+    if (!ctrl_) return;                                        // the HMI has not asked yet
+    pthread_mutex_lock(&lock_);
+    int want = want_;
+    pthread_mutex_unlock(&lock_);
+    if (want == sent_) return;
+    uint8_t v = want ? 0 : 1;                                  // AppState: 0 available (tile shown), 1 not available
+    send(c, client, kFktAppState, most::kOpStatus, &v, 1);
+    sent_ = want;
+    printf("[Tile] main-menu tile %s\n", want ? "shown" : "hidden");
+}
+
+// Top of every DSI callback of the MOST client (sends are only valid on that connection thread).
+void MenuTile::onTick(DsiClient* c, uint32_t client) {
+    pthread_mutex_lock(&lock_);
+    bool reg = registered_, stop = stop_, done = done_;
+    pthread_mutex_unlock(&lock_);
+    if (!reg || done) return;
+    if (stop) {
+        pthread_mutex_lock(&lock_);
+        done_ = true;
+        want_ = 0;
+        pthread_mutex_unlock(&lock_);
+        publish(c, client);                                    // hide the tile first
+        std::vector<uint16_t> keys(1, kTileKey);
+        c->sendRequest(most::kReqUnregisterDevices, most::buildRegisterDevCtrls(client, keys));
+        std::vector<uint8_t> u;
+        most::putLe32(u, client);
+        c->sendRequest(most::kReqUnregisterClient, u);
+        printf("[Tile] device 0x%04X unregistered\n", kTileKey);
+        return;
+    }
+    publish(c, client);
+}
+
+// A MOST message for our device. True when it was consumed (it is then not routed to the other consumers).
+bool MenuTile::onMessage(DsiClient* c, const most::View& m, uint32_t client) {
+    pthread_mutex_lock(&lock_);
+    bool reg = registered_;
+    pthread_mutex_unlock(&lock_);
+    if (!reg || m.fblock != (uint8_t)(kTileKey >> 8) || m.inst != (uint8_t)(kTileKey & 0xff) || m.dst != dev_) return false;
+    if (m.op == most::kOpSet && m.fkt == kFktNotification && m.len == 5 && m.data[0] == 0x01) {
+        ctrl_ = (uint16_t)((m.data[1] << 8) | m.data[2]);
+        uint16_t fid = (uint16_t)((m.data[3] << 8) | m.data[4]);
+        if (fid == kFktAppState) {
+            pthread_mutex_lock(&lock_);
+            int want = want_;
+            pthread_mutex_unlock(&lock_);
+            uint8_t v = want ? 0 : 1;
+            send(c, client, fid, most::kOpStatus, &v, 1);
+            sent_ = want;
+        } else {
+            uint8_t e[4] = { 0x20, 0x10, m.data[3], m.data[4] };
+            send(c, client, kFktNotification, most::kOpError, e, 4);
+        }
+        return true;
+    }
+    if (m.op == most::kOpSet && m.fkt == kFktFocusReq && m.len == 1) {
+        printf("[Tile] the driver selected the %s\n", m.data[0] ? "Media entry" : "main-menu tile");
+        if (cb_) cb_(user_);
+        return true;
+    }
+    return true;                                               // anything else sent to 0x2471 is ignored
+}
+
+} // namespace car
+} // namespace nbt
