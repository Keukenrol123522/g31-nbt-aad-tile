+// SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
+// Required Notice: Copyright (c) 2026 nanaisu - NBT-AAD (https://github.com/Sq00ky/Supra-iDrive6-Android-Auto)
+#ifndef CAR_MENU_TILE_HPP
+#define CAR_MENU_TILE_HPP
+
+#include <pthread.h>
+#include <stddef.h>
+#include <stdint.h>
+#include "most/client.hpp"
+
+namespace nbt {
+namespace car {
+
+typedef void (*TilePressCb)(void* user);
+
+// Main-menu shortcut tile (OPT-IN: NBT_TILE=1; NBT_TILE_ALWAYS=1 keeps it visible without a phone, for testing).
+// Ported onto the MOST client library from the unmerged patch by deathwalker80 (issue #55, written against the old
+// src/ccs_input.cpp). The HMI's native CarLife tile is driven from here: the daemon registers a MOST device FBlock 0x24
+// inst 0x71 (the slot the HMI's CarLife proxy expects), answers the HMI's notification requests, shows the tile with
+// AppState 0 and hides it with 1. Only AppState is ever sent: other CarLife statuses hide the tile again.
+// This is the one place where the daemon SENDS on MOST (registerDevices, processMessage, unregister), and only for
+// that one device. Everything runs on the DSI callback thread; the main loop only sets a flag.
+class MenuTile {
+public:
+    MenuTile();
+
+    // Before the client's start(). False: off (the default) or no room on the client.
+    bool attach(most::Client& client, TilePressCb cb, void* user);
+
+    // From the main loop: true while a phone session is active.
+    void setVisible(bool visible);
+
+    // Hides the tile and unregisters the device and the MOST client; waits up to ~1.5 s for the DSI thread.
+    void shutdown();
+
+private:
+    static void registeredTramp(DsiClient* c, uint32_t client, uint16_t dev, void* self);
+    static bool messageTramp(DsiClient* c, const most::View& m, uint32_t client, void* self);
+    static void tickTramp(DsiClient* c, uint32_t client, void* self);
+    static void linkTramp(most::LinkState s, void* self);
+    void onRegistered(DsiClient* c, uint32_t client, uint16_t dev);
+    bool onMessage(DsiClient* c, const most::View& m, uint32_t client);
+    void onTick(DsiClient* c, uint32_t client);
+    void onLink(most::LinkState s);
+    void send(DsiClient* c, uint32_t client, uint16_t fkt, uint8_t op, const uint8_t* d, size_t n);
+    void publish(DsiClient* c, uint32_t client);
+
+    bool on_;
+    bool always_;
+    TilePressCb cb_;
+    void* user_;
+
+    pthread_mutex_t lock_;   // want_, stop_, done_, registered_: main thread and DSI thread
+    int want_;
+    bool stop_;
+    bool done_;
+    bool registered_;
+
+    // DSI callback thread only.
+    int sent_;               // last AppState published as want (-1: none)
+    uint16_t dev_;           // our MOST device id (from the client response)
+    uint16_t ctrl_;          // the HMI's MOST address, learned from its first request
+};
+
+} // namespace car
+} // namespace nbt
+
+#endif
diff --git a/milestone-7/src/compat_gcc44.cpp b/milestone-7/src/compat_gcc44.cpp
new file mode 100644
